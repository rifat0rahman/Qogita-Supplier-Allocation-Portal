# Qogita API Configuration (auto-provisions a v1 API credential using email & password)
QOGITA_API_URL=https://api.qogita.com
QOGITA_EMAIL=your-buyer-email@example.com
QOGITA_PASSWORD=your-qogita-password

# Optional: Pre-created Qogita v1 API Credential (if set, skips /auth/login/)
QOGITA_CLIENT_ID=
QOGITA_CLIENT_SECRET=
QOGITA_TOKEN_URL=https://auth.qogita.com/oauth/v2/token
QOGITA_TOKEN_SCOPE=

# Optional: Fallback EUR -> USD exchange rate if live FX lookup is offline (default: 1.08)
EUR_USD_RATE=1.08

# MongoDB Atlas Configuration (Optional - falls back to local data/catalog.json if unset)
MONGODB_URI=
